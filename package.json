{
  "name": "poe2-regex",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "test": "pnpm --filter @poe2-regex/regex test && pnpm --filter @poe2-regex/data test && pnpm --filter web test && pnpm test:pipeline",
    "test:pipeline": "node --test scripts/lib/*.test.mjs scripts/*.test.mjs",
    "fetch-data": "node scripts/update-data.mjs",
    "fetch-data:shields": "node scripts/update-data.mjs --shields",
    "fetch-data:endgame": "node scripts/update-data.mjs --endgame",
    "fetch-data:early": "node scripts/update-data.mjs --early",
    "fetch-data:check": "node scripts/update-data.mjs --check",
    "fetch-data:fixtures": "node scripts/update-data.mjs --from-fixtures --out-dir scripts/fixtures/out"
  },
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=20"
  }
}
